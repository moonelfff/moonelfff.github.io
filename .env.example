ADMIN_PASSWORD=change-me
# Optional: random string used as the admin session cookie value
ADMIN_SESSION_TOKEN=

# Optional: without Supabase, content is read from/written to local files
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-images

# Optional: SurveyJS license key
NEXT_PUBLIC_SURVEYJS_LICENSE_KEY=
