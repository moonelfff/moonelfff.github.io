ADMIN_PASSWORD=change-me
# Optional: random string used as the admin session cookie value
ADMIN_SESSION_TOKEN=

# Explicit runtime source. No automatic fallback. Defaults to supabase.
DATA_PROVIDER=supabase
# Test deployments only: disable analytics, structured data and search indexing.
SITE_PREVIEW=0
# Required for DATA_PROVIDER=supabase and for the Supabase -> MySQL importer.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-images

# Required for DATA_PROVIDER=mysql. Keep DB access private.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Optional PEM CA file for verified TLS (required for remote untrusted networks).
MYSQL_SSL_CA=
# Absolute persistent directory outside public_html/public. Include in backups.
MEDIA_ROOT=

# Optional: SurveyJS license key
NEXT_PUBLIC_SURVEYJS_LICENSE_KEY=
